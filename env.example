# ═══════════════════════════════════════════════════════════════════════════════
# LetsShare — Root environment variables
# Copy this file to .env and fill in values before running docker compose.
# Individual app overrides live in each app's own .env file.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Internet frontend (prod build only) ────────────────────────────────────────
# The backend URL as seen FROM THE BROWSER.
# Baked into the JS bundle at `vite build` time — cannot be changed at runtime.
# Dev: leave empty — Vite's proxy handles /socket.io → backend automatically.
# Prod: set to your public domain or LAN IP.
#   e.g. https://share.yourdomain.com   or   http://192.168.1.10:3001
VITE_BACKEND_URL=

# ── Internet backend ───────────────────────────────────────────────────────────
# Restrict CORS in production to your frontend's origin.
# e.g. https://share.yourdomain.com
# Use * only on trusted networks.
INTERNET_CORS_ORIGIN=*

# ── LAN backend ───────────────────────────────────────────────────────────────
# No VITE_BACKEND_URL needed for LAN. The frontend is always served from the
# same origin as the backend (letshare.local:3002), so socket.io connects
# same-origin automatically — no URL embedding required.
LAN_PORT=3002

# ── Metrics beacon (both frontends) ─────────────────────────────────────────
# Relative path — resolved against the page's own origin, then proxied to the
# matching backend (see each app's vite.config.js in dev, nginx.conf in prod).
# Leave unset to disable the beacon entirely (IndexedDB-only local history).
VITE_METRICS_ENDPOINT=/api/metrics

# ── InfluxDB (per backend — see apps/internet/backend/.env and
# apps/lan/backend/.env) ─────────────────────────────────────────────────────
# Each app writes to its own bucket (internet_transfers / lan_transfers) by
# design — this keeps LAN and Internet transfer history isolated, so Grafana
# dashboards for each app never need a mode filter or risk mixing the two.

# ── Observability profile (root .env — copy this file to .env to use it) ────
# Required for `docker compose --profile observability up`. INFLUX_TOKEN must
# be a real value here (not empty) — it becomes the InfluxDB admin token on
# first boot, and both backends' .env files should be set to the same value.
INFLUX_TOKEN=change-me-to-a-real-token
INFLUX_ORG=letshare
INFLUX_ADMIN_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
# Grafana:  http://localhost:3000  (admin / GRAFANA_ADMIN_PASSWORD above)
# InfluxDB: http://localhost:8086  (admin / INFLUX_ADMIN_PASSWORD above)


# With Grafana PDC Client
GCLOUD_PDC_SIGNING_TOKEN=...
GCLOUD_HOSTED_GRAFANA_ID=...
GCLOUD_PDC_CLUSTER=prod-us-central-0   # example