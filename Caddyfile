# Caddyfile — Caddy provisions and renews the Let's Encrypt certificate for
# {$DOMAIN} automatically; no certbot, no manual renewal cron job needed.
# nginx (inside internet-frontend-prod) still handles /api/ and /socket.io/
# proxying to the backend — Caddy's only job is TLS termination and getting
# traffic to that one container.

letshare.duckdns.org {
	tls internal
	reverse_proxy internet-frontend-prod:80
}
localhost {
	tls internal
	reverse_proxy lan-frontend-prod:80
}

