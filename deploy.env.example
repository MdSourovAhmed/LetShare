# Copy this to .env in the same directory as docker-compose.deploy.yml on the VPS.
# This file lives ONLY on the VPS — never commit real values to git.

GHCR_OWNER=your-github-username

# Caddy needs this to request a Let's Encrypt certificate — must have a DNS
# A record pointing at this VPS's public IP before you first run
# `docker compose up`, or the certificate request will fail.
DOMAIN=share.yourdomain.com

# The real domain the frontend is served from — must be an exact origin
# match (scheme + host + port), or the backend will reject the socket
# connection. No trailing slash.
INTERNET_CORS_ORIGIN=https://share.yourdomain.com

# Leave INFLUX_TOKEN empty to disable metrics writes entirely (the JSONL
# log in ./logs/internet-backend/ still gets written either way).
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=letshare
INFLUX_ORG=letshare

# ── TURN server (coturn) ─────────────────────────────────────────────────
# VPS_PUBLIC_IP: run `curl ifconfig.me` on the VPS itself to get this.
# TURN_USERNAME / TURN_CREDENTIAL: pick any values — these are NOT your
# VPS login, just a shared secret between this server and every client.
# These three, plus VITE_TURN_URL, must ALSO be set as GitHub secrets
# (Settings -> Secrets and variables -> Actions) so the frontend build
# bakes in matching values — see .github/workflows/deploy-internet.yml.
# VITE_TURN_URL should be: turn:<VPS_PUBLIC_IP>:3478
VPS_PUBLIC_IP=
TURN_REALM=yourdomain.com
TURN_USERNAME=
TURN_CREDENTIAL=
