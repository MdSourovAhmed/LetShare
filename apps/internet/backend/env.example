# ═══════════════════════════════════════════════════════════════════════════════
# Internet Backend — environment variables
# Copy to .env in this directory.
# ═══════════════════════════════════════════════════════════════════════════════

# Port the signaling server listens on.
# Must match the proxy target in apps/internet/frontend/vite.config.js (dev)
# and the VITE_BACKEND_URL port (prod).
PORT=3001

# Allowed CORS origins for socket.io connections.
# Dev:  * (allow all origins — safe on a local machine)
# Prod: lock to your frontend's exact origin to prevent abuse.
#   e.g. CORS_ORIGIN=https://share.yourdomain.com
CORS_ORIGIN=*

# Node environment — affects Express error verbosity and optimisations.
# Options: development | production
NODE_ENV=development
