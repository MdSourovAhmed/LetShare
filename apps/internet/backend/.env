# ═══════════════════════════════════════════════════════════════════════════════
# Internet Backend — environment variables
# Copy to .env in this directory.
# ═══════════════════════════════════════════════════════════════════════════════

# Port the signaling server listens on.
# Must match the proxy target in apps/internet/frontend/vite.config.js (dev)
# and the VITE_BACKEND_URL port (prod).
PORT=3001

# Allowed CORS origins for socket.io connections.
# Dev:  * (allow all origins — safe on a local machine)
# Prod: lock to your frontend's exact origin to prevent abuse.
#   e.g. CORS_ORIGIN=https://share.yourdomain.com
CORS_ORIGIN=*

# Node environment — affects Express error verbosity and optimisations.
# Options: development | production
NODE_ENV=development

# ── Observability (InfluxDB) ─────────────────────────────────────────────────
# Own bucket, separate from apps/lan/backend/.env — Internet and LAN transfer
# metrics are never mixed, so Grafana dashboards never need a mode filter and
# there's no accidental cross-app comparison.
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=  # set to match root .env when running the observability profile
INFLUX_ORG=letshare
INFLUX_BUCKET=internet_transfers

# ── Local transfer log (JSONL — one JSON object per line) ──────────────────
# Durable copy, independent of InfluxDB. Analyze with `jq` or pandas.
METRICS_LOG_FILE=./logs/internet-transfers.jsonl
