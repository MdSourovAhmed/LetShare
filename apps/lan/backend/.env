# ═══════════════════════════════════════════════════════════════════════════════
# LAN Backend — environment variables
# Copy to .env in this directory.
# ═══════════════════════════════════════════════════════════════════════════════

# Port the LAN signaling server and mDNS advertisement listen on.
# The server advertises itself as letshare.local:<PORT> on the network.
# Any device on the LAN can reach it at http://letshare.local:3002
PORT=3002

# Node environment
NODE_ENV=development

# ── Observability (InfluxDB) ─────────────────────────────────────────────────
# Own bucket, separate from apps/internet/backend/.env — Internet and LAN
# transfer metrics are never mixed, so Grafana dashboards never need a mode
# filter and there's no accidental cross-app comparison.
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=  # set to match root .env when running the observability profile
INFLUX_ORG=letshare
INFLUX_BUCKET=lan_transfers

# ── Local transfer log (JSONL — one JSON object per line) ──────────────────
# Durable copy, independent of InfluxDB. Analyze with `jq` or pandas.
METRICS_LOG_FILE=./logs/lan-transfers.jsonl

# ── mDNS notes ─────────────────────────────────────────────────────────────────
# The backend uses bonjour-service to advertise letshare.local via mDNS.
# This works automatically on Linux (bare metal or network_mode: host in Docker).
# On macOS and Windows with Docker Desktop, mDNS multicast is blocked by the
# NAT layer — run the backend directly with `npm run dev -w apps/lan/backend`
# instead of inside Docker.
