# Internet frontend — Vite environment variables
# All variables MUST start with VITE_ to be exposed to the browser bundle.
# Copy to .env in this directory.

# Dev:  leave empty — vite.config.js proxy handles /socket.io → localhost:3001
# Prod: set to the full public URL of the internet backend
#       e.g. https://share.yourdomain.com
VITE_BACKEND_URL=
