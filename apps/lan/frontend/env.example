# Leave this EMPTY for LAN mode. It's a build-time variable baked as a
# literal string into the client JS bundle — "http://localhost:3002" works
# on the machine that built it, but breaks every OTHER device on the
# network, since "localhost" in their browser means themselves, not the
# host machine. Empty means "connect same-origin," which Vite's dev proxy
# (or nginx in prod) then correctly forwards to the real backend — see
# apps/lan/frontend/src/lib/socket.js.
VITE_BACKEND_URL=

VITE_METRICS_ENDPOINT=/api/metrics
